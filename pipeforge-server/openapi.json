  "paths" : {
    "/api/v1/components/{type}/{identifier}" : {
      "get" : {
        "description" : "The options of a source, transform or sink: types, defaults, requirements and the rules between them.",
        "operationId" : "getComponent",
        "parameters" : [ {
          "description" : "source, transform or sink",
          "in" : "path",
          "name" : "type",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The component identifier, e.g. jdbc",
          "in" : "path",
          "name" : "identifier",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Plugin id or id@version; required when several plugins provide it",
          "in" : "query",
          "name" : "plugin",
          "required" : false,
          "schema" : {
            "type" : [ "string", "null" ]
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ComponentInfo"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorInfo"
                }
              }
            },
            "description" : "The request is invalid (PF-CONF-0007)"
          },
          "422" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorInfo"
                }
              }
            },
            "description" : "The job, expression or plugin options are invalid"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorInfo"
                }
              }
            },
            "description" : "Internal error (PF-SYS-0001)"
          }
        },
        "summary" : "Describe a component",
        "tags" : [ "plugins" ],
        "x-zh-CN" : {
          "description" : "Source、Transform 或 Sink 的选项：类型、默认值、是否必填以及选项之间的规则。",
          "summary" : "查看组件"
        }
