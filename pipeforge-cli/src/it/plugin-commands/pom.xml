<!-- A small transform plugin, built and tested with the pipeforge plugin commands. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.example</groupId>
    <artifactId>upper-plugin</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-api</artifactId>
            <version>@project.version@</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-connector-testkit</artifactId>
            <version>@project.version@</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>@maven-surefire-plugin.version@</version>
            </plugin>
            <plugin>
                <groupId>org.devlive.pipeforge</groupId>
                <artifactId>pipeforge-maven-plugin</artifactId>
                <version>@project.version@</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>package</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
