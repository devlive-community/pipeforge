<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.devlive.pipeforge</groupId>
        <artifactId>pipeforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pipeforge-e2e</artifactId>
    <name>PipeForge End-to-End Tests</name>
    <description>
        End-to-end tests of a cluster made of the packaged distribution: a master, three workers and the
        server as processes, MySQL and PostgreSQL in containers. They run after packaging, need Docker
        and are skipped without it, or with -Dpipeforge.e2e.skip.
    </description>

    <properties>
        <pipeforge.e2e.skip>false</pipeforge.e2e.skip>
        <!-- the end-to-end tests; the benchmark profile turns them off -->
        <pipeforge.e2e.its.skip>${pipeforge.e2e.skip}</pipeforge.e2e.its.skip>
    </properties>

    <dependencies>
        <!-- the release archive, unpacked for the tests -->
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-dist</artifactId>
            <version>${project.version}</version>
            <type>tar.gz</type>
            <scope>test</scope>
        </dependency>

        <!-- the checkpoint storage interface, for the faulty storage of the chaos framework -->
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- the tests load and check the databases; Connector/J also becomes the driver plugin -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>pipeforge-dist</includeArtifactIds>
                            <includeTypes>tar.gz</includeTypes>
                            <outputDirectory>${project.build.directory}/dist</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <skip>${pipeforge.e2e.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- nothing runs in the test phase; the *IT tests run on the unpacked distribution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
                <executions>
                    <execution>
                        <id>e2e</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>${pipeforge.e2e.its.skip}</skip>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <pipeforge.dist>${project.build.directory}/dist/pipeforge-${project.version}</pipeforge.dist>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The M1 acceptance benchmark (development/benchmarks): -Pbenchmark runs *Benchmark instead of the
          end-to-end tests, with its settings as -Dpipeforge.benchmark.* properties.
        -->
        <profile>
            <id>benchmark</id>
            <properties>
                <pipeforge.e2e.its.skip>true</pipeforge.e2e.its.skip>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>benchmark</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <excludes combine.self="override"/>
                                    <includes>
                                        <include>**/*Benchmark.java</include>
                                    </includes>
                                    <systemPropertyVariables>
                                        <pipeforge.dist>${project.build.directory}/dist/pipeforge-${project.version}</pipeforge.dist>
                                    </systemPropertyVariables>
                                    <!-- a hundred million rows take a while; no time limit of the fork -->
                                    <forkedProcessTimeoutInSeconds>0</forkedProcessTimeoutInSeconds>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
