{
  "name": "@pipeforge/client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TypeScript client of the PipeForge REST API, generated from the server's OpenAPI document",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate.mjs --check && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
