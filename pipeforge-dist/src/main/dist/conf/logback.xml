<!--
  The logs of the cluster processes: logs/pipeforge-<role>.log, a new file every day or every
  100 MB, kept for 14 days. The scripts set pipeforge.log.dir and pipeforge.role. Lines a task
  writes carry its run/vertex/subtask/attempt.

  TASKS writes what each task logs, also on its write thread, into a file of its own under
  worker.log.dir, where the master reads it; it rolls and removes these files after the worker.log
  settings. Keep the timestamp and the level at the start of its pattern: readers filter by level.
-->
<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${pipeforge.log.dir:-logs}/pipeforge-${pipeforge.role:-process}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${pipeforge.log.dir:-logs}/pipeforge-${pipeforge.role:-process}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %X{pipeforge.task:-} %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="TASKS" class="org.devlive.pipeforge.engine.worker.log.TaskLogAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.grpc" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="TASKS"/>
    </root>
</configuration>
