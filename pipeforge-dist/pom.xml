<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.devlive.pipeforge</groupId>
        <artifactId>pipeforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pipeforge-dist</artifactId>
    <name>PipeForge Distribution</name>
    <description>The distribution: the pipeforge command, the master, worker and standalone processes, their scripts and configuration</description>

    <dependencies>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-rpc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-network</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-master</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-worker</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- s3:// checkpoint storage; the processes find it with ServiceLoader -->
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-engine-checkpoint-s3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- The logging of the cluster processes (conf/logback.xml); packaged into lib/logback. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Packaged, never on the class path that runs: the server and the bundled plugins. -->
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-server</artifactId>
            <version>${project.version}</version>
            <classifier>exec</classifier>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-fake</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-console</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-blackhole</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-mysql</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-postgres</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-jdbc-generic</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>transform-field-mapper</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Unit tests run before packaging; *IT tests run the packaged scripts after it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>scripts</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <pipeforge.dist>${project.build.directory}/pipeforge-${project.version}</pipeforge.dist>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>pipeforge-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <descriptors>
                                <descriptor>src/main/assembly/dir.xml</descriptor>
                                <descriptor>src/main/assembly/tar.xml</descriptor>
                            </descriptors>
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
