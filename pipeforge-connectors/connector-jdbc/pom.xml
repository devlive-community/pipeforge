<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.devlive.pipeforge</groupId>
        <artifactId>pipeforge-connectors</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>connector-jdbc</artifactId>
    <name>PipeForge Connector JDBC</name>
    <description>
        B09 JDBC connector base: range and single splits, streaming reads, batched writes with retries
        and bad row bisection, and the dialect SPI. Not a plugin itself: the plugins of each database
        (and the generic JDBC plugin) depend on it and ship it in their package.
    </description>

    <dependencies>
        <!-- The engine provides slf4j to plugins, like the API. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
