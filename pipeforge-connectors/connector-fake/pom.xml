            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.devlive.pipeforge</groupId>
                <artifactId>pipeforge-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
