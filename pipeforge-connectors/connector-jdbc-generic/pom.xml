<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.devlive.pipeforge</groupId>
        <artifactId>pipeforge-connectors</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>connector-jdbc-generic</artifactId>
    <name>PipeForge Connector JDBC (generic)</name>
    <description>
        S02 generic JDBC source and K05 sink on the JDBC connector base with the ANSI dialect, for
        databases without a plugin of their own. Users bring the JDBC driver as a driver plugin; verified with H2.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>connector-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.devlive.pipeforge</groupId>
            <artifactId>pipeforge-connector-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.devlive.pipeforge</groupId>
                <artifactId>pipeforge-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
