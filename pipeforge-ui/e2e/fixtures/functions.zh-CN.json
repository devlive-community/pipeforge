  {
    "name": "COALESCE",
    "category": "comparison",
    "syntax": "COALESCE(value, ...)",
    "deterministic": true,
    "signatures": ["COALESCE(INT32, INT64) → INT64"],
    "description": "返回第一个不为 NULL 的参数；后面的参数只在需要时才计算。",
    "nulls": "只有所有参数都为 NULL 时才返回 NULL。",
    "examples": [
      {
        "expression": "COALESCE(NULL, 'b', 'c')",
        "result": "b"
      },
      {
        "expression": "COALESCE(NULL, NULL)",
        "result": "NULL"
      }
    ]
  },
