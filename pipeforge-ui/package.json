{
  "name": "@pipeforge/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "PipeForge Web UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:ui": "node scripts/lint-ui.mjs",
    "test": "node scripts/lint-ui.mjs && tsc --noEmit && vitest run",
    "e2e": "playwright test --project smoke",
    "screenshots": "playwright test --project screenshots"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@pipeforge/client": "workspace:*",
    "@pipeforge/design-tokens": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "8.5.1",
    "yaml": "2.8.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
